[debug] [2026-09-02T12:01:07.501Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/astoo-9b922/rulesets {"name":"projects/astoo-9b922/rulesets/64dd7e2d-edbc-4fd4-a981-27360847c7c0","source":{"files":[{"content":"rules_version = '2';\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    function signedIn() {\n      return request.auth != null && request.auth.token.email != null;\n    }\n\n    function isMember() {\n      return signedIn()\n        && exists(/databases/$(database)/documents/allowedUsers/$(request.auth.token.email));\n    }\n\n    function isAdmin() {\n      return isMember()\n        && get(/databases/$(database)/documents/allowedUsers/$(request.auth.token.email)).data.role == \"admin\";\n    }\n\n    function isBootstrapAdmin(email) {\n      return signedIn()\n        && request.auth.token.email == email\n        && !exists(/databases/$(database)/documents/appConfig/bootstrap)\n        && existsAfter(/databases/$(database)/documents/appConfig/bootstrap)\n        && getAfter(/databases/$(database)/documents/appConfig/bootstrap).data.ownerEmail == email;\n    }\n\n    function isPublicVehicleSubmission(vehicleId) {\n      return request.auth == null\n        && request.resource.data.keys().hasOnly([\n          \"id\", \"name\", \"make\", \"model\", \"year\", \"color\", \"vehicleType\",\n          \"licensePlate\", \"vin\", \"currentMileage\", \"createdAt\", \"updatedAt\", \"status\"\n        ])\n        && request.resource.data.id == vehicleId\n        && request.resource.data.make is string\n        && request.resource.data.model is string\n        && request.resource.data.licensePlate is string;\n    }\n\n    function isPublicRuleSubmission() {\n      return request.auth == null\n        && request.resource.data.keys().hasOnly([\n          \"id\", \"vehicleId\", \"intervalKm\", \"intervalMonths\", \"warningKm\",\n          \"warningDays\", \"lastServiceMileage\", \"lastServiceDate\"\n        ])\n        && request.resource.data.id is string\n        && request.resource.data.vehicleId is string\n        && existsAfter(/databases/$(database)/documents/vehicles/$(request.resource.data.vehicleId));\n    }\n\n    match /appConfig/bootstrap {\n      allow get: if signedIn();\n      allow create: if signedIn()\n        && !exists(/databases/$(database)/documents/appConfig/bootstrap)\n        && request.resource.data.keys().hasOnly([\"ownerEmail\", \"initializedAt\"])\n        && request.resource.data.ownerEmail == request.auth.token.email\n        && existsAfter(/databases/$(database)/documents/allowedUsers/$(request.auth.token.email))\n        && getAfter(/databases/$(database)/documents/allowedUsers/$(request.auth.token.email)).data.role == \"admin\";\n    }\n\n    match /allowedUsers/{email} {\n      allow get: if isAdmin() || (signedIn() && request.auth.token.email == email);\n      allow list: if isAdmin();\n      allow create: if (isAdmin() && request.resource.data.role == \"subordinate\")\n        || (isBootstrapAdmin(email) && request.resource.data.role == \"admin\");\n      allow update, delete: if isAdmin();\n    }\n\n    match /vehicles/{vehicleId} {\n      allow read, update, delete: if isMember();\n      allow create: if isMember() || isPublicVehicleSubmission(vehicleId);\n    }\n\n    match /rules/{ruleId} {\n      allow read, update, delete: if isMember();\n      allow create: if isMember() || isPublicRuleSubmission();\n    }\n\n    match /records/{recordId} {\n      allow read, write: if isMember();\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-09-02T12:01:05.396071Z","metadata":{"services":["cloud.firestore"]}}
