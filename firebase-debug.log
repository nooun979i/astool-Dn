[debug] [2026-09-06T11:35:35.042Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/astoo-9b922/rulesets {"name":"projects/astoo-9b922/rulesets/822c4e6d-dcbc-46c8-800d-1f907039954b","source":{"files":[{"content":"rules_version = '2';\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    function isAdmin() {\n      return request.auth != null && request.auth.token.email == \"moon@astool.com\";\n    }\n\n    function hasText(value, maxLength) {\n      return value is string && value.size() > 0 && value.size() <= maxLength;\n    }\n\n    function validDriverUpdate(updateId) {\n      let publicVehicle = get(/databases/$(database)/documents/publicVehicles/$(request.resource.data.qrToken));\n      let vehicle = get(/databases/$(database)/documents/vehicles/$(publicVehicle.data.vehicleId));\n      return request.auth == null\n        && request.resource.data.keys().hasOnly([\n          'id', 'vehicleId', 'qrToken', 'plateNumber', 'vehicleName', 'driverName', 'nationalId',\n          'previousMileage', 'newMileage', 'notes', 'faultReported', 'issueId', 'createdAt'\n        ])\n        && request.resource.data.id == updateId\n        && request.resource.data.vehicleId == publicVehicle.data.vehicleId\n        && request.resource.data.plateNumber == publicVehicle.data.licensePlate\n        && request.resource.data.vehicleName == publicVehicle.data.vehicleName\n        && hasText(request.resource.data.driverName, 100)\n        && request.resource.data.driverName == vehicle.data.assignedDriverName\n        && request.resource.data.nationalId is string\n        && request.resource.data.nationalId.matches('^[0-9]{10}$')\n        && request.resource.data.nationalId == vehicle.data.assignedDriverNationalId\n        && request.resource.data.previousMileage is int\n        && request.resource.data.newMileage is int\n        && request.resource.data.previousMileage == publicVehicle.data.currentMileage\n        && request.resource.data.newMileage >= request.resource.data.previousMileage\n        && request.resource.data.notes is string\n        && request.resource.data.notes.size() <= 800\n        && request.resource.data.faultReported is bool\n        && request.resource.data.createdAt == request.time\n        && getAfter(/databases/$(database)/documents/vehicles/$(request.resource.data.vehicleId)).data.currentMileage == request.resource.data.newMileage\n        && getAfter(/databases/$(database)/documents/vehicles/$(request.resource.data.vehicleId)).data.lastDriverUpdateId == updateId\n        && getAfter(/databases/$(database)/documents/publicVehicles/$(request.resource.data.qrToken)).data.currentMileage == request.resource.data.newMileage\n        && getAfter(/databases/$(database)/documents/publicVehicles/$(request.resource.data.qrToken)).data.lastDriverUpdateId == updateId;\n    }\n\n    function validPublicVehicleMileageUpdate(vehicleId) {\n      let updateId = request.resource.data.lastDriverUpdateId;\n      let driverUpdate = getAfter(/databases/$(database)/documents/driverUpdates/$(updateId));\n      return request.auth == null\n        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentMileage', 'updatedAt', 'lastDriverUpdateId'])\n        && request.resource.data.currentMileage >= resource.data.currentMileage\n        && request.resource.data.updatedAt is int\n        && updateId is string\n        && driverUpdate.data.vehicleId == vehicleId\n        && driverUpdate.data.previousMileage == resource.data.currentMileage\n        && driverUpdate.data.newMileage == request.resource.data.currentMileage;\n    }\n\n    function validPublicAccessMileageUpdate(token) {\n      let updateId = request.resource.data.lastDriverUpdateId;\n      let driverUpdate = getAfter(/databases/$(database)/documents/driverUpdates/$(updateId));\n      return request.auth == null\n        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentMileage', 'updatedAt', 'lastDriverUpdateId'])\n        && request.resource.data.currentMileage >= resource.data.currentMileage\n        && request.resource.data.updatedAt is int\n        && updateId is string\n        && driverUpdate.data.qrToken == token\n        && driverUpdate.data.vehicleId == resource.data.vehicleId\n        && driverUpdate.data.previousMileage == resource.data.currentMileage\n        && driverUpdate.data.newMileage == request.resource.data.currentMileage;\n    }\n\n    function validIssue(issueId) {\n      let driverUpdate = getAfter(/databases/$(database)/documents/driverUpdates/$(request.resource.data.driverUpdateId));\n      return request.auth == null\n        && request.resource.data.keys().hasOnly([\n          'id', 'vehicleId', 'driverUpdateId', 'plateNumber', 'vehicleName', 'driverName', 'nationalId',\n          'description', 'priority', 'status', 'createdAt'\n        ])\n        && request.resource.data.id == issueId\n        && request.resource.data.driverUpdateId is string\n        && driverUpdate.data.faultReported == true\n        && request.resource.data.vehicleId == driverUpdate.data.vehicleId\n        && request.resource.data.plateNumber == driverUpdate.data.plateNumber\n        && request.resource.data.vehicleName == driverUpdate.data.vehicleName\n        && request.resource.data.driverName == driverUpdate.data.driverName\n        && request.resource.data.nationalId == driverUpdate.data.nationalId\n        && hasText(request.resource.data.description, 800)\n        && request.resource.data.priority in ['منخفضة', 'متوسطة', 'عالية', 'طارئة']\n        && request.resource.data.status == 'جديد'\n        && request.resource.data.createdAt == request.time\n        && request.resource.data.id == driverUpdate.data.issueId;\n    }\n\n    function validDriverAudit(auditId) {\n      let driverUpdate = getAfter(/databases/$(database)/documents/driverUpdates/$(request.resource.data.driverUpdateId));\n      return request.auth == null\n        && request.resource.data.keys().hasOnly([\n          'id', 'actorType', 'actorName', 'actorNationalId', 'action', 'vehicleId', 'plateNumber',\n          'oldData', 'newData', 'driverUpdateId', 'issueId', 'priority', 'createdAt'\n        ])\n        && request.resource.data.id == auditId\n        && request.resource.data.actorType == 'driver'\n        && request.resource.data.actorName == driverUpdate.data.driverName\n        && request.resource.data.actorNationalId == driverUpdate.data.nationalId\n        && request.resource.data.action == 'تحديث ممشى من QR'\n        && request.resource.data.vehicleId == driverUpdate.data.vehicleId\n        && request.resource.data.plateNumber == driverUpdate.data.plateNumber\n        && request.resource.data.driverUpdateId == driverUpdate.data.id\n        && request.resource.data.issueId == driverUpdate.data.issueId\n        && request.resource.data.oldData.currentMileage == driverUpdate.data.previousMileage\n        && request.resource.data.newData.currentMileage == driverUpdate.data.newMileage\n        && request.resource.data.createdAt == request.time;\n    }\n\n    match /publicVehicles/{token} {\n      allow get: if true;\n      allow list: if false;\n      allow create, delete: if isAdmin();\n      allow update: if isAdmin() || validPublicAccessMileageUpdate(token);\n    }\n\n    match /vehicles/{vehicleId} {\n      allow read, create, delete: if isAdmin();\n      allow update: if isAdmin() || validPublicVehicleMileageUpdate(vehicleId);\n    }\n\n    match /driverUpdates/{updateId} {\n      allow read, update, delete: if isAdmin();\n      allow create: if isAdmin() || validDriverUpdate(updateId);\n    }\n\n    match /vehicleIssues/{issueId} {\n      allow read, update, delete: if isAdmin();\n      allow create: if isAdmin() || validIssue(issueId);\n    }\n\n    match /auditLogs/{auditId} {\n      allow read, update, delete: if isAdmin();\n      allow create: if isAdmin() || validDriverAudit(auditId);\n    }\n\n    match /rules/{ruleId} {\n      allow read, write: if isAdmin();\n    }\n\n    match /records/{recordId} {\n      allow read, write: if isAdmin();\n    }\n\n    match /plates/{plateKey} {\n      allow read, write: if isAdmin();\n    }\n\n    match /{document=**} {\n      allow read, write: if false;\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-09-06T11:35:35.044767Z","metadata":{"services":["cloud.firestore"]}}
